{
  "name": "jve-portfolio-backend",
  "version": "1.2.0",
  "main": "index.ts",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "check": "tsc --noEmit",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "format": "prettier --write \"src/**/*.{js,ts}\"",
    "seed": "npx prisma migrate reset --force"
  },
  "prisma": {
    "seed": "ts-node prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "^7.3.0",
    "bcrypt": "^6.0.0",
    "cors": "^2.8.5",
    "dotenv": "^17.2.3",
    "express": "^5.2.1",
    "express-validator": "^7.0.1",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0"
  },
  "devDependencies": {
    "@types/node": "^25.2.0",
    "prisma": "^7.3.0",
    "tsx": "^4.21.0",
    "typescript": "^5.4.3"
  }
}